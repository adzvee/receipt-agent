# Copy this file to .env and fill in real values. Never commit .env.

# --- Database (matches docker-compose.yml) ---
POSTGRES_USER=receipts
POSTGRES_PASSWORD=receipts
POSTGRES_DB=receipts
# Host port 5433 avoids clashing with a locally installed Postgres on 5432.
DATABASE_URL=postgresql+psycopg://receipts:receipts@localhost:5433/receipts

# --- App ---
APP_ENV=development

# --- LLM ---
# Get a key at https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash

# --- Accounts ---
# Secret used to sign login tokens. Required when APP_ENV isn't "development".
# Generate one with: python3 -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=

# --- Email forwarding (Postmark inbound webhook) ---
# Choose any username and a long random password, then use them in the webhook URL you
# give Postmark: https://USERNAME:PASSWORD@your-domain/webhooks/postmark/inbound
# Generate a password with: python3 -c "import secrets; print(secrets.token_urlsafe(32))"
# Leave empty to keep the endpoint disabled.
POSTMARK_INBOUND_USERNAME=
POSTMARK_INBOUND_PASSWORD=
# Your Postmark inbound address; users forward to its "+token" variant.
POSTMARK_INBOUND_ADDRESS=
